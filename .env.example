# Moddedrealms website settings.
# Copy this file to .env (cp .env.example .env) and fill it in.

# Your domain, without https:// or www (e.g. moddedrealms.net).
# Caddy uses it to get a free HTTPS certificate automatically.
DOMAIN=example.com

# Full public URL of the site, used for link previews on Discord/Twitter.
# The Docker setup fills this in from DOMAIN for you.
SITE_URL=https://example.com

# Discord webhook that receives feedback and player reports.
# In Discord: Server Settings > Integrations > Webhooks > New Webhook > Copy Webhook URL
DISCORD_WEBHOOK_URL=

# Optional: send feedback and reports to different channels (each overrides DISCORD_WEBHOOK_URL).
DISCORD_FEEDBACK_WEBHOOK_URL=
DISCORD_REPORT_WEBHOOK_URL=

# Optional: a role to @mention whenever a player report comes in.
# Turn on Developer Mode in Discord, then right-click the role > Copy Role ID.
DISCORD_REPORT_PING_ROLE_ID=

# Port the website listens on, and whether it sits behind a reverse proxy like Caddy or nginx.
PORT=3000
TRUST_PROXY=true

# Maximum form submissions per visitor every 15 minutes.
SUBMIT_RATE_LIMIT=5

# ---------- Accounts ----------

# Secret shared with the Moddedrealms Link Minecraft plugin (put the same value in its config.yml).
# Generate one with:  node server/manage.js plugin-key
# Leave empty to turn off Minecraft account linking.
PLUGIN_API_KEY=

# In-game ranks (from LuckPerms/Vault) that get access to the staff dashboard, comma separated.
STAFF_RANKS=owner,admin,administrator,manager,moderator,mod,helper,staff

# ---------- AI bots (optional) ----------
# Secret the bot managers (ai-bot/manager) use to connect; put the same value in their manager.json.
# Generate one with:  openssl rand -hex 24      Leave empty to turn the bot hub off.
BOT_MANAGER_KEY=
# Largest .litematic staff can upload, in MB.
BOT_UPLOAD_MAX_MB=10

# ---------- Email (optional) ----------
# Lets players get updates about their reports and reset forgotten passwords.
# Works with any email provider that gives you SMTP details (Gmail app password, Brevo, Mailgun, Zoho...).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---------- Live data ----------

# Sources for the live player count, Discord member count and latest videos.
MC_SERVER_ADDRESS=moddedrealms.minehut.gg
# Optional: override the max players shown on the homepage (normally read from the server itself).
MC_MAX_PLAYERS=
DISCORD_INVITE_CODE=AA3a3H3ECk
YOUTUBE_CHANNEL_ID=UC408m1zoIwbW5JXeOkqSlxA
